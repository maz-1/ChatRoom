{
  "inbounds": [],
  "reverse": {
    "bridges": [{ "tag": "bridge", "domain": "reverse.internal.example" }]
  },
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "proxy.example.com",
            "port": 443,
            "users": [
              {
                "id": "d342d11e-d424-4583-b36e-524ab1f0afa4",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "proxy.example.com",
          "allowInsecure": false
        },
        "wsSettings": {
          "path": "/tunnel",
          "headers": { "Host": "proxy.example.com" }
        }
      },
      "mux": { "enabled": false }
    },
    {
      "tag": "mcp-local",
      "protocol": "freedom",
      "settings": { "redirect": "127.0.0.1:8765" }
    },
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["bridge"],
        "domain": ["full:reverse.internal.example"],
        "outboundTag": "proxy"
      },
      { "type": "field", "inboundTag": ["bridge"], "outboundTag": "mcp-local" }
    ]
  }
}
