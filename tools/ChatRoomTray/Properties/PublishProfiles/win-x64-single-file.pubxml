<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Visual Studio needs the folder-publish metadata as well as MSBuild settings. -->
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Requires Microsoft .NET 8 Desktop Runtime (x64) on the target PC. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Keep the Visual Studio and CLI destinations identical. -->
    <PublishUrl>bin\Release\publish\win-x64-single-file\</PublishUrl>
    <PublishDir>bin\Release\publish\win-x64-single-file\</PublishDir>
  </PropertyGroup>
</Project>