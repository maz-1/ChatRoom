<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ChatRoomTray</AssemblyName>
    <RootNamespace>ChatRoomTray</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon>..\chatgpt.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ChatRoomConfigEditor\ConfigPaths.cs" Link="ConfigEditor\ConfigPaths.cs" />
    <Compile Include="..\ChatRoomConfigEditor\ConfigStore.cs" Link="ConfigEditor\ConfigStore.cs" />
    <Compile Include="..\ChatRoomConfigEditor\ConfigValidator.cs" Link="ConfigEditor\ConfigValidator.cs" />
    <Compile Include="..\ChatRoomConfigEditor\MainForm.cs" Link="ConfigEditor\MainForm.cs" />
    <Compile Include="..\ChatRoomConfigEditor\MainForm.Layout.cs" Link="ConfigEditor\MainForm.Layout.cs" />
    <Compile Include="..\ChatRoomConfigEditor\McpServerConverter.cs" Link="ConfigEditor\McpServerConverter.cs" />
    <Compile Include="..\ChatRoomConfigEditor\McpServerDialog.cs" Link="ConfigEditor\McpServerDialog.cs" />
    <Compile Include="..\ChatRoomConfigEditor\Models.cs" Link="ConfigEditor\Models.cs" />
    <Compile Include="..\ChatRoomConfigEditor\OwnerToken.cs" Link="ConfigEditor\OwnerToken.cs" />
    <Compile Include="..\ChatRoomConfigEditor\TextInputDialog.cs" Link="ConfigEditor\TextInputDialog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\chatgpt.ico" Link="chatgpt.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>